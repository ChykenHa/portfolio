@page
@model IndexModel
@{
    ViewData["Title"] = "Portfolio";
}

<main>
    <!-- 1. HERO SECTION -->
    <section id="hero" class="hero-section">
        <div class="container hero-grid">
            <div class="hero-copy">
                <div class="status-pill reveal">
                    <span class="status-dot" aria-hidden="true"></span>
                    <span>Open to Software Developer &amp; Backend Roles · Da Nang, VN</span>
                </div>

                <h1 class="hero-title reveal">
                    @Model.Profile.FullName
                </h1>

                <p class="hero-role reveal">
                    @Model.Profile.Title &middot; <span class="text-accent">ASP.NET Core &amp; Backend Systems</span>
                </p>

                <p class="hero-summary reveal">
                    Software Engineering student at <strong>@Model.Profile.University</strong> with hands-on internship experience at
                    <strong>Samsung R&amp;D Center Vietnam</strong> and <strong>Wisdom Brain</strong>. Focused on building resilient C# / ASP.NET Core backends,
                    relational databases, and containerized DevOps workflows.
                </p>

                <div class="hero-cta-row reveal">
                    <a href="#projects" class="btn btn-primary">
                        <span>Explore Projects</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>
                    <a href="~/@Model.Profile.CvFileName" target="_blank" rel="noopener" class="btn btn-secondary">
                        <i class="fa-solid fa-file-arrow-down"></i>
                        <span>Download CV</span>
                    </a>
                    <button type="button" class="btn btn-ghost" data-copy="@Model.Profile.Email" data-copy-label="Email address">
                        <i class="fa-regular fa-copy"></i>
                        <span>Copy Email</span>
                    </button>
                </div>

                <div class="hero-social-row reveal">
                    <a href="@Model.Profile.GithubUrl" target="_blank" rel="noopener" class="social-pill">
                        <i class="fa-brands fa-github"></i> GitHub / @Model.Profile.GithubHandle
                    </a>
                    <a href="@Model.Profile.LinkedInUrl" target="_blank" rel="noopener" class="social-pill">
                        <i class="fa-brands fa-linkedin-in"></i> LinkedIn
                    </a>
                    <span class="social-pill muted">
                        <i class="fa-solid fa-location-dot"></i> @Model.Profile.Location
                    </span>
                </div>
            </div>

            <!-- Identity Bento Card -->
            <aside class="hero-bento spotlight-surface reveal" aria-label="Developer Quick Profile">
                <div class="bento-profile-head">
                    <div class="avatar-frame">
                        <img src="~/images/avatar.jpg" alt="Le Phung Ha portrait" class="avatar-img" loading="eager" />
                    </div>
                    <div class="bento-profile-meta">
                        <span class="mono-pill accent">C# / .NET · DevOps</span>
                        <h2 class="bento-name">@Model.Profile.FullName</h2>
                        <p class="bento-sub">@Model.Profile.University (@Model.Profile.EducationPeriod)</p>
                    </div>
                </div>

                <div class="bento-metrics-grid">
                    @foreach (var stat in Model.HeroStats)
                    {
                        <div class="metric-tile">
                            <span class="metric-val">@stat.Value</span>
                            <span class="metric-lbl">@stat.Label</span>
                            <span class="metric-sub">@stat.Sub</span>
                        </div>
                    }
                </div>

                <div class="code-card">
                    <div class="code-card-bar">
                        <span class="dot red"></span>
                        <span class="dot amber"></span>
                        <span class="dot green"></span>
                        <span class="code-filename">developer.json</span>
                    </div>
                    <pre class="code-body"><code>{
  <span class="tok-k">"focus"</span>: [<span class="tok-s">"ASP.NET Core"</span>, <span class="tok-s">"EF Core"</span>, <span class="tok-s">"SQL Server"</span>],
  <span class="tok-k">"devops"</span>: [<span class="tok-s">"Docker"</span>, <span class="tok-s">"Kubernetes"</span>, <span class="tok-s">"Grafana"</span>],
  <span class="tok-k">"mobile"</span>: [<span class="tok-s">"Java"</span>, <span class="tok-s">"Kotlin"</span>, <span class="tok-s">"MVVM"</span>],
  <span class="tok-k">"award"</span>: <span class="tok-s">"3rd Prize · IT Research 2026"</span>
}</code></pre>
                </div>
            </aside>
        </div>
    </section>

    <!-- 2. ABOUT & CREDENTIALS BENTO -->
    <section id="about" class="section">
        <div class="container">
            <div class="section-header reveal">
                <span class="section-eyebrow">01 / Profile</span>
                <h2 class="section-title">About &amp; Credentials</h2>
                <p class="section-desc">Academic foundation, career objective, and verified achievements.</p>
            </div>

            <div class="about-bento-grid">
                <!-- Career Objective -->
                <article class="bento-card span-7 spotlight-surface reveal">
                    <div class="card-kicker"><i class="fa-solid fa-bullseye"></i> Career Objective</div>
                    <h3 class="card-heading">Building dependable backend &amp; database systems</h3>
                    <p class="card-copy">
                        @Model.Profile.Objective
                    </p>
                    <p class="card-copy secondary">
                        Through internships at <strong>Samsung R&amp;D Center Vietnam</strong> and <strong>Wisdom Brain</strong>,
                        alongside independent full-stack AI research, I bridge clean C# backend architecture with containerized operations and practical problem-solving.
                    </p>
                </article>

                <!-- Education -->
                <article class="bento-card span-5 spotlight-surface reveal">
                    <div class="card-kicker"><i class="fa-solid fa-graduation-cap"></i> Education</div>
                    <div class="edu-header">
                        <h3 class="card-heading">@Model.Profile.University</h3>
                        <span class="mono-pill">@Model.Profile.EducationPeriod</span>
                    </div>
                    <p class="edu-major">@Model.Profile.Major</p>
                    <div class="gpa-callout">
                        <span class="gpa-label">Cumulative GPA</span>
                        <span class="gpa-value">@Model.Profile.Gpa</span>
                    </div>
                </article>

                <!-- Honors & Award -->
                <article class="bento-card span-6 award-card spotlight-surface reveal">
                    <div class="card-kicker amber"><i class="fa-solid fa-trophy"></i> Honors &amp; Awards · @Model.Award.Year</div>
                    <h3 class="card-heading">@Model.Award.Title</h3>
                    <p class="card-copy">
                        Recognized for <strong>MindConnect</strong> — an independent cross-platform social network integrating Python NLP models, Google Gemini, and smartwatch biometric PEWS tracking.
                    </p>
                </article>

                <!-- Certifications & Beyond Code -->
                <article class="bento-card span-6 spotlight-surface reveal">
                    <div class="card-kicker"><i class="fa-solid fa-certificate"></i> Certifications &amp; Beyond Code</div>
                    <div class="cert-list">
                        @foreach (var cert in Model.Certifications)
                        {
                            <div class="cert-pill">
                                <span class="cert-name">@cert.Title</span>
                                <span class="cert-meta">@cert.Year &middot; @cert.Meta</span>
                            </div>
                        }
                    </div>
                    <p class="beyond-note">
                        <i class="fa-solid fa-sparkles"></i>
                        Outside of engineering: collecting Mecha action figures, aquascaping freshwater tanks, and tactical Valorant matches.
                    </p>
                </article>
            </div>
        </div>
    </section>

    <!-- 3. EXPERIENCE SECTION -->
    <section id="experience" class="section section-alt">
        <div class="container">
            <div class="section-header reveal">
                <span class="section-eyebrow">02 / Experience</span>
                <h2 class="section-title">Industry Internships</h2>
                <p class="section-desc">Practical software engineering and DevOps delivery in production-oriented environments.</p>
            </div>

            <div class="timeline">
                @foreach (var exp in Model.Experiences)
                {
                    <article class="timeline-item reveal">
                        <div class="timeline-marker" aria-hidden="true">
                            <i class="@exp.IconClass"></i>
                        </div>
                        <div class="timeline-card spotlight-surface">
                            <div class="exp-top">
                                <div>
                                    <span class="exp-company">@exp.Company</span>
                                    <h3 class="exp-role">@exp.Role</h3>
                                </div>
                                <div class="exp-badges">
                                    <span class="mono-pill">@exp.Period</span>
                                    <span class="mono-pill accent">@exp.CategoryTag</span>
                                </div>
                            </div>

                            <ul class="exp-bullets">
                                @foreach (var bullet in exp.Highlights)
                                {
                                    <li>@bullet</li>
                                }
                            </ul>

                            <div class="chip-row">
                                @foreach (var tag in exp.TechTags)
                                {
                                    <span class="tech-chip">@tag</span>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>

    <!-- 4. RESEARCH SPOTLIGHT: MINDCONNECT -->
    <section id="research" class="section">
        <div class="container">
            <div class="section-header reveal">
                <span class="section-eyebrow">03 / Research Spotlight</span>
                <h2 class="section-title">MindConnect Social Network</h2>
                <p class="section-desc">@Model.MindConnect.Event &middot; @Model.MindConnect.Period</p>
            </div>

            <div class="research-shell spotlight-surface reveal">
                <div class="research-main">
                    <div class="research-badges">
                        <span class="award-ribbon">
                            <i class="fa-solid fa-award"></i> @Model.MindConnect.Award
                        </span>
                        <span class="mono-pill">@Model.MindConnect.Role</span>
                    </div>

                    <h3 class="research-title">@Model.MindConnect.Name</h3>
                    <p class="research-desc">@Model.MindConnect.Description</p>

                    <div class="pillars-grid">
                        @foreach (var pillar in Model.MindConnect.Pillars)
                        {
                            <div class="pillar-card">
                                <div class="pillar-icon"><i class="@pillar.IconClass"></i></div>
                                <div>
                                    <h4 class="pillar-title">@pillar.Title</h4>
                                    <p class="pillar-desc">@pillar.Description</p>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="chip-row">
                        @foreach (var tag in Model.MindConnect.TechTags)
                        {
                            <span class="tech-chip">@tag</span>
                        }
                    </div>

                    <div class="research-actions">
                        <a href="@Model.MindConnect.GithubUrl" target="_blank" rel="noopener" class="btn btn-primary">
                            <i class="fa-brands fa-github"></i>
                            <span>Explore Source Code</span>
                        </a>
                    </div>
                </div>

                <!-- Interactive 3-Tab Product Preview -->
                <div class="research-preview" aria-label="MindConnect Interactive Architecture Preview">
                    <div class="preview-window">
                        <div class="preview-topbar">
                            <div class="window-dots" aria-hidden="true">
                                <span class="dot red"></span>
                                <span class="dot amber"></span>
                                <span class="dot green"></span>
                            </div>
                            <span class="preview-url">mindconnect.app / telemetry</span>
                        </div>

                        <div class="preview-tabs" role="tablist" aria-label="MindConnect Feature Previews">
                            <button type="button" class="preview-tab active" role="tab" aria-selected="true" data-tab="nlp">NLP Classifier</button>
                            <button type="button" class="preview-tab" role="tab" aria-selected="false" data-tab="pews">Smartwatch &rarr; PEWS</button>
                            <button type="button" class="preview-tab" role="tab" aria-selected="false" data-tab="gemini">Gemini AI</button>
                        </div>

                        <div class="preview-panels">
                            <!-- Panel 1: NLP -->
                            <div class="preview-panel active" data-panel="nlp" role="tabpanel">
                                <div class="mock-post">
                                    <div class="mock-user">
                                        <span class="mock-avatar">U</span>
                                        <div>
                                            <strong>User Post #1042</strong>
                                            <span>Web &amp; React Native Sync</span>
                                        </div>
                                        <span class="signal-badge danger">Signal Detected</span>
                                    </div>
                                    <p class="mock-text">
                                        "Lately I feel exhausted every morning and disconnected from my classes..."
                                    </p>
                                </div>
                                <div class="mock-telemetry-row">
                                    <div class="mini-stat">
                                        <span>Endpoint</span>
                                        <code>POST /api/nlp/classify</code>
                                    </div>
                                    <div class="mini-stat">
                                        <span>Sentiment</span>
                                        <strong class="text-rose">High Risk (0.87)</strong>
                                    </div>
                                </div>
                            </div>

                            <!-- Panel 2: Smartwatch PEWS -->
                            <div class="preview-panel" data-panel="pews" role="tabpanel" hidden>
                                <div class="biometrics-grid">
                                    <div class="bio-tile">
                                        <span class="bio-code">Hv</span>
                                        <span class="bio-name">Heart Rate</span>
                                        <strong class="bio-val">104 <small>bpm</small></strong>
                                    </div>
                                    <div class="bio-tile">
                                        <span class="bio-code">St</span>
                                        <span class="bio-name">Sleep Time</span>
                                        <strong class="bio-val">4.5 <small>hrs</small></strong>
                                    </div>
                                    <div class="bio-tile">
                                        <span class="bio-code">Dv</span>
                                        <span class="bio-name">Emotion State</span>
                                        <strong class="bio-val text-amber">Stressed</strong>
                                    </div>
                                    <div class="bio-tile highlight">
                                        <span class="bio-code">PEWS</span>
                                        <span class="bio-name">Alert Tier</span>
                                        <strong class="bio-val text-accent">Monitored</strong>
                                    </div>
                                </div>
                                <p class="mock-caption">Smartwatch telemetry (Hv, St, Dv) synced to PEWS monitoring pipeline.</p>
                            </div>

                            <!-- Panel 3: Gemini AI -->
                            <div class="preview-panel" data-panel="gemini" role="tabpanel" hidden>
                                <div class="mock-chat">
                                    <div class="chat-msg user">
                                        I have been struggling to sleep before project deadlines.
                                    </div>
                                    <div class="chat-msg bot">
                                        <span class="bot-tag"><i class="fa-solid fa-sparkles"></i> Google Gemini Support</span>
                                        <p>Let's break tonight into a 25-minute wind-down routine and prioritize one small task for tomorrow morning.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 5. PROJECTS SECTION -->
    <section id="projects" class="section section-alt">
        <div class="container">
            <div class="section-header-row reveal">
                <div class="section-header compact">
                    <span class="section-eyebrow">04 / Selected Work</span>
                    <h2 class="section-title">Engineering Projects</h2>
                    <p class="section-desc">Full-stack ASP.NET Core applications, mobile apps, and desktop software.</p>
                </div>

                <div class="filter-bar" role="group" aria-label="Filter projects by category">
                    <button type="button" class="filter-pill active" data-filter="all">All <span class="filter-count" id="project-count">@Model.Projects.Count</span></button>
                    <button type="button" class="filter-pill" data-filter="web">Backend &amp; Web</button>
                    <button type="button" class="filter-pill" data-filter="mobile">Mobile</button>
                    <button type="button" class="filter-pill" data-filter="desktop">Desktop &amp; UI</button>
                </div>
            </div>

            <!-- Featured CV Projects -->
            <div class="projects-group" data-group="featured">
                <h3 class="group-label">Featured CV Projects</h3>
                <div class="projects-grid featured-grid">
                    @foreach (var project in Model.Projects.Where(p => p.IsFeatured))
                    {
                        <article class="project-card featured spotlight-surface reveal" data-category="@project.Category" data-project-id="@project.Id">
                            <div class="project-card-top">
                                <div class="project-icon-box">
                                    <i class="@project.IconClass"></i>
                                </div>
                                <span class="mono-pill">@project.Period</span>
                            </div>

                            <span class="project-role-tag">@project.Role</span>
                            <h4 class="project-title">@project.Name</h4>
                            <p class="project-summary">@project.Summary</p>

                            <ul class="project-mini-list">
                                @foreach (var item in project.Highlights.Take(3))
                                {
                                    <li>@item</li>
                                }
                            </ul>

                            <div class="chip-row">
                                @foreach (var tag in project.TechTags)
                                {
                                    <span class="tech-chip">@tag</span>
                                }
                            </div>

                            <div class="project-actions">
                                <a href="@project.GithubUrl" target="_blank" rel="noopener" class="btn btn-secondary btn-sm">
                                    <i class="fa-brands fa-github"></i> GitHub
                                </a>
                                <button type="button" class="btn btn-ghost btn-sm view-details-btn" data-project-id="@project.Id">
                                    <span>View Details</span>
                                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                </button>
                            </div>
                        </article>
                    }
                </div>
            </div>

            <!-- Additional GitHub Projects -->
            <div class="projects-group" data-group="additional">
                <h3 class="group-label">Additional GitHub Showcase</h3>
                <div class="projects-grid compact-grid">
                    @foreach (var project in Model.Projects.Where(p => !p.IsFeatured))
                    {
                        <article class="project-card spotlight-surface reveal" data-category="@project.Category" data-project-id="@project.Id">
                            <div class="project-card-top">
                                <div class="project-icon-box">
                                    <i class="@project.IconClass"></i>
                                </div>
                                <span class="mono-pill">@project.Period</span>
                            </div>

                            <span class="project-role-tag">@project.Role</span>
                            <h4 class="project-title">@project.Name</h4>
                            <p class="project-summary">@project.Summary</p>

                            <div class="chip-row">
                                @foreach (var tag in project.TechTags)
                                {
                                    <span class="tech-chip">@tag</span>
                                }
                            </div>

                            <div class="project-actions">
                                <a href="@project.GithubUrl" target="_blank" rel="noopener" class="btn btn-secondary btn-sm">
                                    <i class="fa-brands fa-github"></i> GitHub
                                </a>
                                <button type="button" class="btn btn-ghost btn-sm view-details-btn" data-project-id="@project.Id">
                                    <span>Details</span>
                                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                </button>
                            </div>
                        </article>
                    }
                </div>
            </div>
        </div>
    </section>

    <!-- 6. TECHNICAL & SOFT SKILLS -->
    <section id="skills" class="section">
        <div class="container">
            <div class="section-header reveal">
                <span class="section-eyebrow">05 / Capabilities</span>
                <h2 class="section-title">Technical &amp; Soft Skills</h2>
                <p class="section-desc">Core stack highlighted with <span class="inline-dot" aria-hidden="true"></span> indicators across backend, databases, and DevOps.</p>
            </div>

            <div class="skills-bento-grid">
                @foreach (var group in Model.SkillGroups)
                {
                    <article class="skill-card spotlight-surface reveal">
                        <div class="skill-card-head">
                            <span class="skill-icon"><i class="@group.IconClass"></i></span>
                            <h3 class="skill-group-title">@group.Title</h3>
                        </div>
                        <div class="skill-badges-wrap">
                            @foreach (var skill in group.Items)
                            {
                                <span class="skill-badge @(skill.IsCore ? "core" : "")">
                                    @if (skill.IsCore)
                                    {
                                        <span class="core-dot" aria-hidden="true"></span>
                                    }
                                    @skill.Name
                                </span>
                            }
                        </div>
                    </article>
                }
            </div>

            <div class="soft-skills-strip reveal">
                @foreach (var soft in Model.SoftSkills)
                {
                    <div class="soft-skill-card spotlight-surface">
                        <div class="soft-head">
                            <i class="@soft.IconClass"></i>
                            <h4>@soft.Title</h4>
                        </div>
                        <p>@soft.Description</p>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- 7. CONTACT SECTION -->
    <section id="contact" class="section section-alt">
        <div class="container">
            <div class="section-header reveal">
                <span class="section-eyebrow">06 / Contact</span>
                <h2 class="section-title">Let's Connect</h2>
                <p class="section-desc">Available for C# / ASP.NET Core Software Developer roles and engineering collaborations.</p>
            </div>

            <div class="contact-grid">
                <div class="contact-cards reveal">
                    <div class="contact-card spotlight-surface">
                        <div class="contact-icon"><i class="fa-solid fa-envelope"></i></div>
                        <div class="contact-info">
                            <span class="contact-label">Email</span>
                            <a href="mailto:@Model.Profile.Email" class="contact-val">@Model.Profile.Email</a>
                        </div>
                        <button type="button" class="icon-btn" data-copy="@Model.Profile.Email" data-copy-label="Email address" aria-label="Copy email address">
                            <i class="fa-regular fa-copy"></i>
                        </button>
                    </div>

                    <div class="contact-card spotlight-surface">
                        <div class="contact-icon"><i class="fa-solid fa-phone"></i></div>
                        <div class="contact-info">
                            <span class="contact-label">Phone</span>
                            <a href="@Model.Profile.PhoneHref" class="contact-val">@Model.Profile.Phone</a>
                        </div>
                        <button type="button" class="icon-btn" data-copy="@Model.Profile.Phone" data-copy-label="Phone number" aria-label="Copy phone number">
                            <i class="fa-regular fa-copy"></i>
                        </button>
                    </div>

                    <div class="contact-card spotlight-surface">
                        <div class="contact-icon"><i class="fa-solid fa-location-dot"></i></div>
                        <div class="contact-info">
                            <span class="contact-label">Location</span>
                            <p class="contact-val">@Model.Profile.Location</p>
                        </div>
                    </div>

                    <div class="contact-links-bar">
                        <a href="@Model.Profile.GithubUrl" target="_blank" rel="noopener" class="btn btn-secondary btn-sm">
                            <i class="fa-brands fa-github"></i> GitHub
                        </a>
                        <a href="@Model.Profile.LinkedInUrl" target="_blank" rel="noopener" class="btn btn-secondary btn-sm">
                            <i class="fa-brands fa-linkedin-in"></i> LinkedIn
                        </a>
                        <a href="~/@Model.Profile.CvFileName" target="_blank" rel="noopener" class="btn btn-secondary btn-sm">
                            <i class="fa-solid fa-file-pdf"></i> Resume PDF
                        </a>
                    </div>
                </div>

                <!-- Real Mailto & Copy Composer -->
                <div class="composer-card spotlight-surface reveal">
                    <h3 class="composer-title">Quick Message Composer</h3>
                    <p class="composer-sub">Opens directly in your default email app or copies a formatted message to your clipboard.</p>

                    <form id="contact-composer" data-recipient="@Model.Profile.Email">
                        <div class="form-row">
                            <div class="form-field">
                                <label for="c-name">Your Name</label>
                                <input type="text" id="c-name" name="name" required placeholder="Nguyen Van A" />
                            </div>
                            <div class="form-field">
                                <label for="c-email">Your Email</label>
                                <input type="email" id="c-email" name="email" required placeholder="recruiter@company.com" />
                            </div>
                        </div>

                        <div class="form-field">
                            <label for="c-subject">Subject</label>
                            <input type="text" id="c-subject" name="subject" required placeholder="Software Developer Opportunity" />
                        </div>

                        <div class="form-field">
                            <label for="c-message">Message</label>
                            <textarea id="c-message" name="message" rows="4" required placeholder="Hi Ha, we would love to discuss..."></textarea>
                        </div>

                        <div class="composer-actions">
                            <button type="submit" class="btn btn-primary">
                                <i class="fa-solid fa-paper-plane"></i>
                                <span>Open in Email App</span>
                            </button>
                            <button type="button" class="btn btn-secondary" id="copy-composed-btn">
                                <i class="fa-regular fa-copy"></i>
                                <span>Copy Message</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>
</main>

<!-- Embedded Strongly-Typed Project Data for Modal -->
<script type="application/json" id="projects-data">@Html.Raw(Model.ProjectsJson)</script>
